// ============================================================
// PHARMA PACKS SAAS — Maroc (Version 2 — Corrigée & Optimisée)
// Coller sur https://dbdiagram.io pour visualiser
// ============================================================


// ========================
// GLOBAL (référentiels partagés)
// ========================

Table regions {
  id         bigint       [pk, increment]
  name       varchar(100) [not null]
  code       varchar(10)  [not null, unique]
  created_at timestamp
  updated_at timestamp
}

Table provinces {
  id         bigint       [pk, increment]
  region_id  bigint       [not null, ref: > regions.id]
  name       varchar(100) [not null]
  code       varchar(10)  [not null, unique]
  created_at timestamp
  updated_at timestamp
}

Table products {
  id           bigint        [pk, increment]
  name         varchar(200)  [not null]
  reference    varchar(50)   [not null, unique]
  unit         varchar(50)   [not null, note: 'boîte | flacon | ampoule']
  public_price decimal(10,2) [not null, note: 'Prix Public Marocain (PPM)']
  tva_rate     decimal(5,2)  [not null, default: 7.00, note: '0% | 7% | 20%']
  category     varchar(100)
  active       boolean       [default: true]
  created_at   timestamp
  updated_at   timestamp
}


// ========================
// TENANTS (Laboratoires)
// ========================

Table tenants {
  id         bigint       [pk, increment]
  name       varchar(200) [not null]
  slug       varchar(100) [not null, unique]
  logo       varchar(255)
  plan       varchar(50)  [not null, note: 'basic | pro | enterprise']
  active     boolean      [default: true]
  created_at timestamp
  updated_at timestamp
}

Table users {
  id         bigint       [pk, increment]
  tenant_id  bigint       [ref: > tenants.id, note: 'null pour répartiteur']
  name       varchar(200) [not null]
  email      varchar(200) [not null, unique]
  password   varchar(255) [not null]
  role       varchar(50)  [not null, note: 'admin_labo | dsm | delegue | repartiteur']
  active     boolean      [default: true]
  created_at timestamp
  updated_at timestamp
}


// ========================
// ORGANISATION INTERNE
// ========================

Table dsms {
  id         bigint [pk, increment]
  user_id    bigint [not null, ref: > users.id]
  tenant_id  bigint [not null, ref: > tenants.id]
  region_id  bigint [not null, ref: > regions.id]
  created_at timestamp
  updated_at timestamp
}

Table delegues {
  id          bigint [pk, increment]
  user_id     bigint [not null, ref: > users.id]
  tenant_id   bigint [not null, ref: > tenants.id]
  dsm_id      bigint [not null, ref: > dsms.id]
  province_id bigint [not null, ref: > provinces.id]
  created_at  timestamp
  updated_at  timestamp
}

Table repartiteurs {
  id              bigint       [pk, increment]
  name            varchar(200) [not null]
  erp_type        varchar(100) [note: 'Silog | Sage | custom']
  erp_api_url     varchar(255)
  erp_credentials text         [note: 'chiffré AES-256']
  active          boolean      [default: true]
  created_at      timestamp
  updated_at      timestamp
}

Table repartiteur_tenant {
  repartiteur_id bigint    [not null, ref: > repartiteurs.id]
  tenant_id      bigint    [not null, ref: > tenants.id]
  created_at     timestamp

  indexes {
    (repartiteur_id, tenant_id) [pk]
  }
}

Table repartiteur_province {
  repartiteur_id bigint [not null, ref: > repartiteurs.id]
  province_id    bigint [not null, ref: > provinces.id]

  indexes {
    (repartiteur_id, province_id) [pk]
  }
}


// ========================
// PHARMACIES & PORTEFEUILLE
// ========================

Table pharmacies {
  id          bigint        [pk, increment]
  name        varchar(200)  [not null]
  owner_name  varchar(200)
  ice         varchar(15)   [note: 'Identifiant Commun de l Entreprise — Maroc']
  rc          varchar(20)   [note: 'Registre du Commerce']
  address     text
  province_id bigint        [not null, ref: > provinces.id]
  phone       varchar(20)
  email       varchar(200)
  whatsapp    varchar(20)
  latitude    decimal(10,8)
  longitude   decimal(11,8)
  active      boolean       [default: true]
  created_at  timestamp
  updated_at  timestamp
}

Table delegue_pharmacie {
  delegue_id   bigint    [not null, ref: > delegues.id]
  pharmacie_id bigint    [not null, ref: > pharmacies.id]
  assigned_at  timestamp [not null]

  indexes {
    (delegue_id, pharmacie_id) [pk]
  }

  Note: 'Contrainte applicative : delegues.province_id doit = pharmacies.province_id'
}


// ========================
// PACKS
// ========================

Table packs {
  id               bigint        [pk, increment]
  tenant_id        bigint        [not null, ref: > tenants.id]
  dsm_id           bigint        [not null, ref: > dsms.id]
  repartiteur_id   bigint        [not null, ref: > repartiteurs.id]
  name             varchar(200)  [not null]
  start_date       date          [not null]
  end_date         date          [not null]
  status           varchar(50)   [not null, default: 'draft', note: 'draft | negotiation | active | exhausted | expired | stockout']
  qty_limit        int           [note: 'null = illimité']
  amount_limit     decimal(12,2) [note: 'null = illimité, en MAD']
  qty_consumed     int           [default: 0]
  amount_consumed  decimal(12,2) [default: 0]
  conditions_notes text
  validated_at     timestamp
  created_at       timestamp
  updated_at       timestamp
}

Table pack_products {
  id         bigint        [pk, increment]
  pack_id    bigint        [not null, ref: > packs.id]
  product_id bigint        [not null, ref: > products.id]
  moq        int           [not null, default: 1, note: 'Minimum Order Quantity']
  unit_price decimal(10,2) [not null]
  created_at timestamp
}

Table pack_discounts {
  id              bigint       [pk, increment]
  pack_product_id bigint       [not null, ref: > pack_products.id, note: 'Remise par produit du pack']
  type            varchar(20)  [not null, note: 'percentage | gratuity']
  percentage_value decimal(5,2) [note: 'ex: 15.00 pour 15%']
  buy_qty         int          [note: 'ex: 10 pour formule 10+2']
  free_qty        int          [note: 'ex: 2 pour formule 10+2']
  created_at      timestamp
}


// ========================
// OBJECTIFS
// ========================

Table objectives {
  id              bigint        [pk, increment]
  tenant_id       bigint        [not null, ref: > tenants.id]
  period_month    tinyint       [not null]
  period_year     smallint      [not null]
  assignable_type varchar(100)  [not null, note: 'App\\Models\\Dsm | App\\Models\\Delegue']
  assignable_id   bigint        [not null]
  pack_id         bigint        [ref: > packs.id, note: 'null = objectif global tous packs']
  target_qty      int
  target_amount   decimal(12,2)
  created_at      timestamp
  updated_at      timestamp
}


// ========================
// VISITES & COMMANDES
// ========================

Table visits {
  id                bigint      [pk, increment]
  delegue_id        bigint      [not null, ref: > delegues.id]
  pharmacie_id      bigint      [not null, ref: > pharmacies.id]
  pack_id           bigint      [ref: > packs.id, note: 'null = visite de prospection']
  scheduled_at      timestamp   [not null, note: 'date planifiée']
  visited_at        timestamp   [note: 'date réelle — null si pas encore faite']
  status            varchar(20) [not null, default: 'planned', note: 'planned | completed | no_show | cancelled']
  preparation_notes text
  outcome_notes     text
  created_at        timestamp
  updated_at        timestamp
}

Table orders {
  id              bigint        [pk, increment]
  visit_id        bigint        [not null, ref: > visits.id]
  delegue_id      bigint        [not null, ref: > delegues.id]
  pharmacie_id    bigint        [not null, ref: > pharmacies.id]
  pack_id         bigint        [not null, ref: > packs.id]
  repartiteur_id  bigint        [not null, ref: > repartiteurs.id]
  status          varchar(30)   [not null, default: 'pending', note: 'pending | validated | confirmed | refused | delivered | cancelled']
  total_amount    decimal(12,2) [not null, note: 'Montant brut HT']
  discount_amount decimal(12,2) [default: 0]
  tva_amount      decimal(12,2) [default: 0, note: 'TVA calculée par produit']
  net_amount      decimal(12,2) [not null, note: 'Montant TTC final']
  erp_order_ref   varchar(100)  [note: 'référence dans l ERP du répartiteur']
  validated_at    timestamp
  created_at      timestamp
  updated_at      timestamp
}

Table order_items {
  id              bigint        [pk, increment]
  order_id        bigint        [not null, ref: > orders.id]
  product_id      bigint        [not null, ref: > products.id]
  qty_ordered     int           [not null]
  qty_free        int           [not null, default: 0, note: 'unités gratuites — le +2 du 10+2']
  unit_price      decimal(10,2) [not null, note: 'prix après remise %']
  discount_amount decimal(10,2) [default: 0, note: 'montant remise pour traçabilité']
  tva_rate        decimal(5,2)  [not null, note: 'copié depuis products.tva_rate au moment de la commande']
  tva_amount      decimal(10,2) [not null, default: 0]
  total_amount    decimal(12,2) [not null, note: 'TTC ligne']
  created_at      timestamp
}

Table order_validations {
  id           bigint       [pk, increment]
  order_id     bigint       [not null, ref: > orders.id]
  channel      varchar(20)  [not null, note: 'signature | email | whatsapp | phone']
  status       varchar(20)  [not null, default: 'pending', note: 'pending | validated | rejected']
  token        varchar(100) [note: 'token unique pour lien email/whatsapp']
  proof_path   varchar(255) [note: 'chemin fichier signature digitale']
  sent_at      timestamp
  validated_at timestamp
  created_at   timestamp
}


// ========================
// ERP & STOCK
// ========================

Table stock_levels {
  id             bigint    [pk, increment]
  repartiteur_id bigint    [not null, ref: > repartiteurs.id]
  product_id     bigint    [not null, ref: > products.id]
  available_qty  int       [not null]
  last_synced_at timestamp [not null]

  indexes {
    (repartiteur_id, product_id) [unique]
  }
}

Table stock_alerts {
  id             bigint      [pk, increment]
  repartiteur_id bigint      [not null, ref: > repartiteurs.id]
  pack_id        bigint      [not null, ref: > packs.id]
  product_id     bigint      [ref: > products.id, note: 'null = alerte sur tout le pack']
  type           varchar(20) [not null, note: 'low_stock | out_of_stock']
  resolved_at    timestamp
  created_at     timestamp
}

Table erp_sync_logs {
  id             bigint      [pk, increment]
  repartiteur_id bigint      [not null, ref: > repartiteurs.id]
  order_id       bigint      [ref: > orders.id]
  direction      varchar(10) [not null, note: 'outbound | inbound']
  status         varchar(20) [not null, note: 'pending | success | failed']
  payload        json
  response       json
  error_message  text
  synced_at      timestamp
  created_at     timestamp
}


// ========================
// AUDIT
// ========================

Table audit_logs {
  id           bigint       [pk, increment]
  tenant_id    bigint       [ref: > tenants.id]
  causer_type  varchar(100)
  causer_id    bigint
  subject_type varchar(100) [not null]
  subject_id   bigint       [not null]
  event        varchar(50)  [not null, note: 'created | updated | deleted | validated | refused | status_changed']
  old_values   json
  new_values   json
  ip_address   varchar(45)
  created_at   timestamp
}
